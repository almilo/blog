---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesLink from '../../components/SeriesLink.astro';
import { getPublishedPosts, getSeriesPosts, formatDate } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const seriesPosts = post.data.series ? await getSeriesPosts(post.data.series) : [];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={post.data.canonical}
  image={post.data.image}
>
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      {
        post.data.updatedDate && (
          <>
            {' · updated '}
            <time datetime={post.data.updatedDate.toISOString()}>
              {formatDate(post.data.updatedDate)}
            </time>
          </>
        )
      }
    </p>
    {
      post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    <div class="prose">
      <Content />
    </div>
    {
      (post.data.linkedin || post.data.medium) && (
        <p class="discuss">
          Discuss this article:{' '}
          {post.data.linkedin && <a href={post.data.linkedin}>LinkedIn</a>}
          {post.data.linkedin && post.data.medium && ' · '}
          {post.data.medium && <a href={post.data.medium}>Medium</a>}
        </p>
      )
    }
    {
      seriesPosts.length > 0 && (
        <nav class="series" aria-label={`Series: ${post.data.series}`}>
          <p class="series-title">Series: {post.data.series}</p>
          <ol>
            {seriesPosts.map(({ part, companions }) => (
              <li>
                <SeriesLink entry={part} current={post} />
                {companions.length > 0 && (
                  <ul class="companions">
                    {companions.map((companion) => (
                      <li>
                        <SeriesLink entry={companion} current={post} />
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </article>
</BaseLayout>
